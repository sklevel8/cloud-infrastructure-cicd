# Local development only. Never commit real credentials.
# In production every value below is injected by ECS from Secrets Manager.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgres://app:localdev@localhost:5432/app
REDIS_URL=redis://localhost:6379

DATABASE_SSL=false
DATABASE_SSL_VERIFY=false
DATABASE_POOL_SIZE=10

# Must stay below the ECS stopTimeout (30s).
GRACEFUL_SHUTDOWN_MS=20000
READINESS_TIMEOUT_MS=2000

SERVICE_NAME=prod-microservices-api
APP_VERSION=1.0.0
