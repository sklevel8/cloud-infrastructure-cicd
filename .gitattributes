# Normalise line endings so shell scripts and YAML behave identically on
# Windows checkouts and Linux runners.
* text=auto eol=lf

*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
*.json          text eol=lf
*.md            text eol=lf

*.png           binary
*.jpg           binary
*.gif           binary
*.zip           binary
